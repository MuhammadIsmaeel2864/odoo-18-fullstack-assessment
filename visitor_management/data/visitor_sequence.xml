
<odoo>
    <data noupdate="1">

        <record id="sequence_visitor_log"
                model="ir.sequence">

            <field name="name">Visitor Reference</field>
            <field name="code">visitor.log</field>
            <field name="prefix">VIS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>

        </record>

    </data>
</odoo>
