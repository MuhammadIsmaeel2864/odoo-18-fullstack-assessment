
<odoo>

    <!-- ================================= -->
    <!-- 1. VISITOR LIST VIEW -->
    <!-- ================================= -->

    <record id="view_visitor_log_list"
            model="ir.ui.view">

        <field name="name">visitor.log.list</field>
        <field name="model">visitor.log</field>

        <field name="arch" type="xml">
            <list string="Visitor Logs"
                  create="true"
                  edit="true">

                <field name="name" string="Reference"/>
                <field name="visitor_id"/>
                <field name="host_id"/>
                <field name="purpose" optional="show"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration"/>
                <field name="state"
                       widget="badge"/>

            </list>
        </field>
    </record>


    <!-- ================================= -->
    <!-- 2. VISITOR FORM VIEW -->
    <!-- ================================= -->

    <record id="view_visitor_log_form"
            model="ir.ui.view">

        <field name="name">visitor.log.form</field>
        <field name="model">visitor.log</field>

        <field name="arch" type="xml">

            <form string="Visitor Registration">

                <header>

                    <button name="action_check_in"
                            string="Check In"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_check_out"
                            string="Check Out"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'checked_in'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'checked_in')"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,checked_in,checked_out,cancelled"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Visitor Information">

                            <field name="visitor_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>

                            <field name="host_id"/>

                            <field name="purpose"/>

                        </group>

                        <group string="Visit Details">

                            <field name="check_in"
                                   readonly="1"/>

                            <field name="check_out"
                                   readonly="1"/>

                            <field name="duration"
                                   readonly="1"/>

                        </group>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>


    <!-- ================================= -->
    <!-- 3. VISITOR KANBAN VIEW -->
    <!-- ================================= -->

    <record id="view_visitor_log_kanban"
            model="ir.ui.view">

        <field name="name">visitor.log.kanban</field>
        <field name="model">visitor.log</field>

        <field name="arch" type="xml">

            <kanban default_group_by="state"
                    quick_create="false">

                <field name="state"/>

                <templates>

                    <t t-name="card">

                        <div class="p-2">

                            <strong>
                                <field name="name"/>
                            </strong>

                            <div class="mt-2">
                                <strong>Visitor: </strong>
                                <field name="visitor_id"/>
                            </div>

                            <div>
                                <strong>Host: </strong>
                                <field name="host_id"/>
                            </div>

                            <div>
                                <strong>Check In: </strong>
                                <field name="check_in"/>
                            </div>

                            <div>
                                <strong>State: </strong>
                                <field name="state"/>
                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


    <!-- ================================= -->
    <!-- 4. VISITOR CALENDAR VIEW -->
    <!-- ================================= -->

    <record id="view_visitor_log_calendar"
            model="ir.ui.view">

        <field name="name">visitor.log.calendar</field>
        <field name="model">visitor.log</field>

        <field name="arch" type="xml">

            <calendar string="Visitor Calendar"
                      date_start="check_in"
                      color="visitor_id"
                      mode="month"
                      quick_create="false"
                      create="false"
                      event_open_popup="true">

                <field name="name"/>
                <field name="visitor_id"/>
                <field name="host_id"/>
                <field name="state"/>

            </calendar>

        </field>
    </record>

</odoo>
